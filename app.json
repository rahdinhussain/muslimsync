{
  "expo": {
    "name": "Muslim Sync",
    "slug": "muslim-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.muslimsync.app",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Muslim Sync uses your location to calculate accurate prayer times, find nearby mosques, and determine the Qibla direction.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Muslim Sync uses your location to calculate accurate prayer times, find nearby mosques, and determine the Qibla direction."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.muslimsync.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "buildToolsVersion": "34.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Muslim Sync to use your location to find nearby mosques and calculate accurate prayer times."
        }
      ],
      "expo-av",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e5b0eec2-e349-4dea-b1cc-52a101c164d6"
      }
    }
  }
}
