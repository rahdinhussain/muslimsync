{
  "expo": {
    "name": "Muslim Sync",
    "slug": "muslim-sync",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.muslimsync.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Your device location determines Qibla locally. Choosing location for prayer times sends approximate coordinates to AlAdhan.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your device location determines Qibla locally. Choosing location for prayer times sends approximate coordinates to AlAdhan.",
        "CFBundleLocalizations": [
          "en",
          "bn",
          "ar",
          "ur",
          "hi",
          "id",
          "ru",
          "tr"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.muslimsync.app",
      "versionCode": 2026112201,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Your device location determines Qibla locally. Choosing location for prayer times sends approximate coordinates to AlAdhan."
        }
      ],
      "expo-av",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "bn",
              "ar",
              "ur",
              "hi",
              "id",
              "ru",
              "tr"
            ],
            "android": [
              "en",
              "bn",
              "ar",
              "ur",
              "hi",
              "id",
              "ru",
              "tr"
            ]
          },
          "supportsRTL": true,
          "allowDynamicLocaleChangesAndroid": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e5b0eec2-e349-4dea-b1cc-52a101c164d6"
      }
    },
    "locales": {
      "en": "./i18n/native/en.json",
      "bn": "./i18n/native/bn.json",
      "ar": "./i18n/native/ar.json",
      "ur": "./i18n/native/ur.json",
      "hi": "./i18n/native/hi.json",
      "id": "./i18n/native/id.json",
      "ru": "./i18n/native/ru.json",
      "tr": "./i18n/native/tr.json"
    }
  }
}
